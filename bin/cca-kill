#!/usr/bin/env bash
# Clean teardown of cca agent sessions
# Usage: cca-kill [session-name | --all]

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/../lib/tmux-helpers.sh"

ensure_tmux

if [[ "${1:-}" == "--all" ]]; then
  # Kill all cca-managed sessions
  local_sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null \
    | grep -E '^(research|review|feature|orch|custom)-' || true)
  if [[ -z "$local_sessions" ]]; then
    echo "No active agent sessions to kill."
    exit 0
  fi
  while IFS= read -r session; do
    tmux kill-session -t "$session" 2>/dev/null && echo "Killed: $session"
  done <<< "$local_sessions"
else
  SESSION="${1:-$(get_active_session)}"
  if [[ -z "$SESSION" ]]; then
    echo "No active session found. Specify a session name or use --all." >&2
    exit 1
  fi
  tmux kill-session -t "$SESSION" 2>/dev/null && echo "Killed: $SESSION"
fi
